{
  "_version": "1.58.0",
  "sap.app": {
    "id": "com.ccb.viaticos",
    "type": "application",
    "i18n": "i18n/i18n.properties",
    "applicationVersion": {
      "version": "1.0.0"
    },
    "title": "{{appTitle}}",
    "description": "{{appDescription}}",
    "dataSources": {
      "viaticosService": {
        "uri": "/http/",
        "type": "JSON"
      }
    },
    "crossNavigation": {
      "inbounds": {
        "comccbviaticos-show": {
          "semanticObject": "comccbviaticos",
          "action": "show",
          "title": "{{comccbviaticos-show.flpTitle}}",
          "signature": {
            "parameters": {},
            "additionalParameters": "allowed"
          }
        }
      }
    }
  },
  "sap.cloud": {
    "public": true,
    "service": "fiori.viaticos.app"
  },
  "sap.ui": {
    "technology": "UI5",
    "icons": {
      "icon": "",
      "favIcon": "",
      "phone": "",
      "phone@2": "",
      "tablet": "",
      "tablet@2": ""
    },
    "deviceTypes": {
      "desktop": true,
      "tablet": true,
      "phone": true
    }
  },
  "sap.ui5": {
    "flexEnabled": true,
    "rootView": {
      "viewName": "com.ccb.viaticos.view.App",
      "type": "XML",
      "async": true,
      "id": "appView"
    },
    "dependencies": {
      "minUI5Version": "1.120.0",
      "libs": {
        "sap.m": {},
        "sap.ui.core": {},
        "sap.ui.layout": {},
        "sap.f": {}
      }
    },
    "contentDensities": {
      "compact": true,
      "cozy": true
    },
    "models": {
      "i18n": {
        "type": "sap.ui.model.resource.ResourceModel",
        "settings": {
          "bundleName": "com.ccb.viaticos.i18n.i18n"
        }
      },
      "": {
        "type": "sap.ui.model.json.JSONModel"
      },
      "gasto": {
        "type": "sap.ui.model.json.JSONModel"
      }
    },
    "resources": {
      "css": [
        {
          "uri": "css/style.css"
        }
      ]
    },
    "routing": {
      "config": {
        "routerClass": "sap.m.routing.Router",
        "viewType": "XML",
        "async": true,
        "viewPath": "com.ccb.viaticos.view",
        "controlAggregation": "pages",
        "controlId": "app",
        "clearControlAggregation": false
      },
      "routes": [
        {
          "name": "RouteLogin",
          "pattern": "",
          "target": ["TargetLogin"]
        },
        {
          "name": "RouteMain",
          "pattern": "main",
          "target": ["TargetMain"]
        },
        {
          "name": "RouteCapturaMobil",
          "pattern": "captura-movil",
          "target": ["TargetCapturaMobil"]
        },
        {
          "name": "RouteCargaPC",
          "pattern": "carga-pc",
          "target": ["TargetCargaPC"]
        },
        {
          "name": "RouteRevisionDatos",
          "pattern": "revision/{jobId}",
          "target": ["TargetRevisionDatos"]
        },
        {
          "name": "RouteConfirmacion",
          "pattern": "confirmacion/{transaccionId}",
          "target": ["TargetConfirmacion"]
        },
        {
          "name": "RouteListaGastos",
          "pattern": "gastos",
          "target": ["TargetListaGastos"]
        }
      ],
      "targets": {
        "TargetLogin": {
          "viewType": "XML",
          "transition": "fade",
          "clearControlAggregation": false,
          "viewId": "Login",
          "viewName": "Login"
        },
        "TargetMain": {
          "viewType": "XML",
          "transition": "slide",
          "clearControlAggregation": false,
          "viewId": "Main",
          "viewName": "Main"
        },
        "TargetCapturaMobil": {
          "viewType": "XML",
          "transition": "slide",
          "clearControlAggregation": false,
          "viewId": "CapturaMobil",
          "viewName": "CapturaMobil"
        },
        "TargetCargaPC": {
          "viewType": "XML",
          "transition": "slide",
          "clearControlAggregation": false,
          "viewId": "CargaPC",
          "viewName": "CargaPC"
        },
        "TargetRevisionDatos": {
          "viewType": "XML",
          "transition": "slide",
          "clearControlAggregation": false,
          "viewId": "RevisionDatos",
          "viewName": "RevisionDatos"
        },
        "TargetConfirmacion": {
          "viewType": "XML",
          "transition": "slide",
          "clearControlAggregation": false,
          "viewId": "Confirmacion",
          "viewName": "Confirmacion"
        },
        "TargetListaGastos": {
          "viewType": "XML",
          "transition": "slide",
          "clearControlAggregation": false,
          "viewId": "ListaGastos",
          "viewName": "ListaGastos"
        }
      }
    }
  }
}
