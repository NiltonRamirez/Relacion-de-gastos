<mvc:View
    controllerName="com.ccb.viaticos.controller.CapturaMobil"
    xmlns="sap.m"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns:core="sap.ui.core"
    displayBlock="true">
    <Page id="capturaMobilPage" title="{i18n>capturaTitle}" showNavButton="true" navButtonPress="onVolver">
        <content>
            <VBox class="sapUiMediumMargin" alignItems="Center">

                <!-- ============ ESTADO: CÁMARA ACTIVA ============ -->
                <VBox visible="{= ${vm>/estado} === 'camara' }" alignItems="Center">
                    <Text text="{i18n>capturaInstrucciones}" textAlign="Center" class="sapUiSmallMarginBottom"/>

                    <!-- Contenedor del video de la cámara -->
                    <Box class="camaraContainer sapUiSmallMarginBottom">
                        <core:HTML id="videoContainer" content="&lt;video id='videoCamara' class='camaraPreview' autoplay playsinline muted&gt;&lt;/video&gt;"/>
                    </Box>

                    <Button
                        id="btnCapturarCamara"
                        text="{i18n>btnCapturarCamara}"
                        type="Emphasized"
                        icon="sap-icon://camera"
                        press="onCapturarFoto"
                        width="100%"
                        class="sapUiSmallMarginBottom"/>

                    <MessageStrip
                        text="{i18n>errCamaraNoDisponible}"
                        type="Error"
                        showIcon="true"
                        visible="{vm>/errorCamara}"
                        class="sapUiSmallMarginBottom"/>

                    <!-- Permite cancelar la captura y volver a la galería si ya hay facturas -->
                    <Link text="{i18n>btnCerrar}" press="onCancelarCaptura" visible="{= ${vm>/facturas}.length > 0 }" class="sapUiTinyMarginBottom"/>
                    <Link text="{i18n>btnUsarArchivoInstead}" press="onUsarArchivo"/>
                </VBox>

                <!-- ============ ESTADO: VISTA PREVIA DE IMAGEN CAPTURADA ============ -->
                <VBox visible="{= ${vm>/estado} === 'previsualizacion' }" alignItems="Center" width="100%">
                    <Box class="camaraContainer sapUiSmallMarginBottom">
                        <core:HTML id="previewContainer" content="{vm>/htmlPreview}"/>
                    </Box>

                    <!-- Indicador visual de calidad de imagen -->
                    <ObjectStatus
                        text="{i18n>calidadBuena}"
                        icon="sap-icon://message-success"
                        state="Success"
                        visible="{vm>/calidadBuena}"
                        class="sapUiSmallMarginBottom"/>

                    <MessageStrip
                        text="{i18n>calidadMala}"
                        type="Error"
                        showIcon="true"
                        visible="{= !${vm>/calidadBuena} }"
                        class="sapUiSmallMarginBottom"/>

                    <HBox width="100%">
                        <Button
                            text="{i18n>btnReintentar}"
                            icon="sap-icon://camera"
                            press="onReintentar"
                            width="50%"
                            class="sapUiTinyMarginEnd"/>
                        <Button
                            text="{i18n>btnUsarImagen}"
                            type="Emphasized"
                            icon="sap-icon://accept"
                            enabled="{vm>/calidadBuena}"
                            press="onUsarImagen"
                            width="50%"/>
                    </HBox>
                </VBox>

                <!-- ============ ESTADO: GALERÍA DE FACTURAS CAPTURADAS ============ -->
                <VBox visible="{= ${vm>/estado} === 'galeria' }" width="100%">
                    <Title text="{= ${i18n>capturaGaleriaTitulo}.replace('{0}', ${vm>/facturas}.length) }" level="H3" class="sapUiSmallMarginBottom"/>

                    <List items="{vm>/facturas}" class="sapUiSmallMarginBottom">
                        <CustomListItem>
                            <HBox alignItems="Center" justifyContent="SpaceBetween" class="sapUiTinyMargin" width="100%">
                                <HBox alignItems="Center">
                                    <core:HTML content="{vm>htmlThumbnail}"/>
                                    <Text text="{vm>nombreArchivo}" class="sapUiTinyMarginBegin"/>
                                </HBox>
                                <Button icon="sap-icon://delete" type="Transparent" press="onEliminarFactura"/>
                            </HBox>
                        </CustomListItem>
                    </List>

                    <MessageStrip
                        text="{i18n>msgMinimoUnaFactura}"
                        type="Warning"
                        showIcon="true"
                        visible="{= ${vm>/facturas}.length === 0 }"
                        class="sapUiSmallMarginBottom"/>

                    <Button
                        text="{i18n>btnAgregarOtra}"
                        icon="sap-icon://add"
                        press="onAgregarOtra"
                        width="100%"
                        class="sapUiSmallMarginBottom"/>

                    <Button
                        text="{i18n>btnContinuarLote}"
                        type="Emphasized"
                        icon="sap-icon://arrow-right"
                        press="onContinuarLote"
                        enabled="{= ${vm>/facturas}.length > 0 }"
                        width="100%"/>
                </VBox>

                <!-- ============ ESTADO: PROCESANDO OCR ============ -->
                <VBox visible="{= ${vm>/estado} === 'procesando' }" alignItems="Center" justifyContent="Center" class="sapUiLargeMarginTop">
                    <BusyIndicator size="3rem" class="sapUiMediumMarginBottom"/>
                    <Title text="{i18n>procesandoFactura}" level="H3" class="sapUiSmallMarginBottom"/>
                    <Text text="{= ${i18n>procesandoFacturaDesc}.replace('{0}', ${vm>/facturas}.length) }" textAlign="Center"/>
                </VBox>

                <!-- Mensaje de error general (API / conexión) -->
                <MessageStrip
                    text="{vm>/mensajeError}"
                    type="Error"
                    showIcon="true"
                    visible="{vm>/mostrarError}"
                    class="sapUiMediumMarginTop"/>

            </VBox>
        </content>
    </Page>
</mvc:View>
