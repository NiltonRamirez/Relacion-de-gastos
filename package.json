{
  "name": "fiori-viaticos-app",
  "version": "1.0.0",
  "description": "SAP Fiori app for corporate travel expense management (Gestión de Viáticos)",
  "main": "index.js",
  "scripts": {
    "start": "ui5 serve --port 8080 --open index.html",
    "start-flp": "ui5 serve --port 8080 --open flpSandbox.html",
    "build": "ui5 build --clean-dest --dest dist",
    "build:mta": "ui5 build --clean-dest --dest dist && node create-zip.js",
    "create-zip": "node create-zip.js",
    "deploy": "npm run build && cf push",
    "deploy:mta": "mbt build -t ./mta_archives && cf deploy mta_archives/fiori-viaticos-app_1.0.0.mtar",
    "lint": "eslint webapp/",
    "test": "echo \"No tests configured yet\" && exit 0",
    "clean": "rm -rf node_modules dist mta_archives .build target"
  },
  "keywords": [
    "sapui5",
    "fiori",
    "sap btp",
    "viaticos",
    "gastos de viaje"
  ],
  "author": "Cámara de Comercio de Bogotá",
  "license": "UNLICENSED",
  "private": true,
  "devDependencies": {
    "@ui5/cli": "^3.0.0",
    "@sap/ux-ui5-tooling": "^1.0.0",
    "archiver": "^7.0.0",
    "eslint": "^8.0.0"
  },
  "ui5": {
    "dependencies": [
      "@sap/ux-ui5-tooling"
    ]
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=8.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/NiltonRamirez/Relacion-de-gastos.git"
  }
}
